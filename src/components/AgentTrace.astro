---
// ---------------------------------------------------------------------------
// AgentTrace — "how a run looks", printed like a terminal.
//
// The lines are a reading of the approach steps, the stack and the first
// result (see traceLines in caseVisuals.ts). They are NOT a log of a real
// run, and the header says so in the visitor's face. Lines are in the DOM at
// full height from the start, so printing and replaying only ever change
// opacity — the page never shifts. case.ts types them in on scroll and on
// the replay button; under reduced motion everything is shown at once.
// ---------------------------------------------------------------------------
import { brandChipStyle, type Project } from '../data/projects';
import { traceLines } from '../data/caseVisuals';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const lines = traceLines(project);
const prompt: Record<string, string> = {
  cmd: '$', plan: '>', step: '>', sub: '', gate: '>', tools: '>', handoff: '<', exit: '>',
};
---

<div class="trace hud-frame" style={brandChipStyle(project.brand)} data-trace>
  <div class="trace__head">
    <span class="trace__label">How a run looks · illustrative, not a log</span>
    <button class="trace__replay" type="button" data-trace-replay>Replay</button>
  </div>
  <div class="trace__body" aria-live="polite">
    {lines.map((l) => (
      <p class:list={['trace__line', `trace__line--${l.kind}`]}>
        <span class="trace__p" aria-hidden="true">{prompt[l.kind]}</span>
        <span class="trace__t">{l.text}</span>
      </p>
    ))}
    <p class="trace__line trace__line--caret is-in" aria-hidden="true"><span class="trace__p">$</span><span class="trace__caret"></span></p>
  </div>
</div>

<style>
  .trace {
    --ta: var(--chip-a, var(--color-primary));
    --tb: var(--chip-a2, var(--color-primary));
    --hud-c: color-mix(in srgb, var(--ta) 80%, transparent);
    margin-top: 28px;
    background: #121214;
    color: #d2d2d7;
    border: 1px solid color-mix(in srgb, var(--ta) 40%, transparent);
    box-shadow: 6px 6px 0 color-mix(in srgb, var(--ta) 45%, transparent);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.5;
  }
  .trace__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  .trace__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tb);
  }
  .trace__label::before { content: "[ "; opacity: 0.55; }
  .trace__label::after { content: " ]"; opacity: 0.55; }
  .trace__replay {
    padding: 6px 12px;
    font: inherit;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.25);
    cursor: pointer;
  }
  .trace__replay:hover, .trace__replay:focus-visible { border-color: var(--tb); color: var(--tb); }
  .trace__body { padding: 16px 18px 14px; }
  .trace__line {
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr);
    gap: 8px;
    margin: 0 0 3px;
    opacity: 0;
    transform: translateY(3px);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .trace__line.is-in { opacity: 1; transform: none; }
  .trace__p { color: var(--tb); font-weight: 700; }
  .trace__line--cmd .trace__t { color: #fff; font-weight: 700; }
  .trace__line--sub { padding-left: 14px; color: #98989d; }
  .trace__line--gate .trace__t { color: var(--tb); font-weight: 700; }
  .trace__line--tools .trace__t, .trace__line--handoff .trace__t { color: #e4e1f5; }
  .trace__line--exit .trace__t { color: #98989d; }
  .trace__caret { display: inline-block; width: 0.6em; height: 1em; vertical-align: -0.15em; background: var(--tb); animation: trace-caret 1.1s steps(2, start) infinite; }
  @keyframes trace-caret { to { visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) {
    .trace__line { transition: none; }
    .trace__caret { animation: none; }
  }
</style>
