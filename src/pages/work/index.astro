---
// ---------------------------------------------------------------------------
// /work — the portfolio browser.
//
// Wiring notes (all existing hooks, no new JS):
//   • #pc-projects carries [data-filter-root], so every control inside it
//     resolves to the same widgets.ts collection.
//   • Readouts and the empty state sit inside that root too, but declare
//     data-filter-target explicitly so the resolution is never ambiguous.
//   • The tool chips are the site.ts .toolfilter hook (it toggles
//     .work--hidden on section[data-tags]); search/sort/view are the
//     widgets.ts collection hooks. They compose because they act on
//     different channels — class vs inline display.
// ---------------------------------------------------------------------------
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, toolFilters } from '../../data/projects';

const total = projects.length;
const years = projects.map((p) => p.year);
const spanFrom = Math.min(...years);
const spanTo = Math.max(...years);
const orgCount = new Set(projects.map((p) => p.org)).size;
---

<Layout
  title="Portfolio — data analytics case studies"
  description={`${total} delivered analytics projects — dashboards, pipelines and automation, each written up end to end.`}
  ogImage="/images/proposal-overview.svg"
  wide
>
  <!-- ===================== HERO ===================== -->
  <section class="tile tile--white pc-hero" id="portfolio-top">
    <div class="inner" data-stagger>
      <div class="eyebrow" data-reveal-chars>Portfolio</div>
      <h1 class="metrics__h2 pc-hero__h1" data-reveal-words>
        Every project, written up end to end.
      </h1>
      <p class="hero__sub reveal">
        Dashboards, pipelines and automation delivered for sales, operations and finance teams —
        the brief, the build, the numbers that moved. Filter by tool, or search for the problem
        you are trying to solve.
      </p>

      <ul class="pc-hero__facts reveal">
        <li class="pc-fact">
          <span class="pc-fact__v"
            ><strong data-filter-count data-filter-target="#pc-projects" data-count-template="{n}"
              >{total}</strong
            ></span
          >
          <span class="pc-fact__l">projects shown</span>
        </li>
        <li class="pc-fact">
          <span class="pc-fact__v">{orgCount}</span>
          <span class="pc-fact__l">organisations</span>
        </li>
        <li class="pc-fact">
          <span class="pc-fact__v">{spanFrom}–{spanTo}</span>
          <span class="pc-fact__l">delivery window</span>
        </li>
      </ul>

      <p class="pc-hero__jump reveal">
        <a class="textlink" href="#pc-grid">Skip to the project grid</a>
      </p>
    </div>
  </section>

  <!-- ===================== BROWSER ===================== -->
  <section
    class="tile tile--parchment pc-shell"
    id="pc-projects"
    data-filter-root
    data-filter-noun="projects"
    data-view-key="work-grid"
  >
    <div class="inner pc-shell__inner">
      <!-- sticky toolbar -->
      <div class="pc-toolbar">
        <div class="pc-toolbar__row pc-toolbar__row--find">
          <div class="pc-search">
            <label class="u-sr" for="pc-search">Search projects</label>
            <div class="pc-search__field">
              <svg
                class="pc-search__icon"
                viewBox="0 0 20 20"
                width="16"
                height="16"
                aria-hidden="true"
              >
                <circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
                <path d="M12.8 12.8 17 17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
              </svg>
              <input
                class="pc-search__input"
                id="pc-search"
                type="search"
                name="q"
                placeholder="Tableau, forecasting, churn…"
                autocomplete="off"
                data-filter-search
              />
              <button
                class="pc-search__clear"
                type="button"
                data-filter-clear
                data-filter-target="#pc-projects"
              >
                <span class="pc-search__clear-x" aria-hidden="true">×</span>
                <span class="pc-search__clear-t">Clear</span>
              </button>
            </div>
          </div>

          <p class="pc-toolbar__count">
            <span data-filter-count data-filter-target="#pc-projects" data-count-template="{n} of {total}"
              >{total} of {total}</span
            > projects
          </p>
        </div>

        <div class="pc-toolbar__row pc-toolbar__row--controls">
          <div class="toolfilter pc-chips" role="group" aria-label="Filter projects by tool">
            {
              toolFilters.map((f) => (
                <button
                  class="filter-pill pc-chip"
                  type="button"
                  data-filter={f.key}
                  aria-pressed={f.key === 'all' ? 'true' : 'false'}
                >
                  {f.label}
                  <span class="pc-chip__n" aria-hidden="true">{f.count}</span>
                </button>
              ))
            }
          </div>

          <div class="pc-toolbar__end">
            <div class="pc-sort" role="group" aria-label="Sort projects">
              <span class="pc-sort__label" aria-hidden="true">Sort</span>
              <button class="pc-sort__btn" type="button" data-sort="year:desc" aria-pressed="true">
                Newest
              </button>
              <button class="pc-sort__btn" type="button" data-sort="year:asc" aria-pressed="false">
                Oldest
              </button>
              <button class="pc-sort__btn" type="button" data-sort="title:asc" aria-pressed="false">
                A–Z
              </button>
            </div>

            <div class="pc-view" role="group" aria-label="Layout">
              <button
                class="pc-view__btn"
                type="button"
                data-view-toggle="grid"
                aria-pressed="true"
                aria-label="Grid view"
                title="Grid view"
              >
                <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                  <rect x="1" y="1" width="6" height="6" rx="1.4" fill="currentColor"></rect>
                  <rect x="9" y="1" width="6" height="6" rx="1.4" fill="currentColor"></rect>
                  <rect x="1" y="9" width="6" height="6" rx="1.4" fill="currentColor"></rect>
                  <rect x="9" y="9" width="6" height="6" rx="1.4" fill="currentColor"></rect>
                </svg>
              </button>
              <button
                class="pc-view__btn"
                type="button"
                data-view-toggle="list"
                aria-pressed="false"
                aria-label="List view"
                title="List view"
              >
                <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                  <rect x="1" y="2" width="14" height="2.6" rx="1.3" fill="currentColor"></rect>
                  <rect x="1" y="6.7" width="14" height="2.6" rx="1.3" fill="currentColor"></rect>
                  <rect x="1" y="11.4" width="14" height="2.6" rx="1.3" fill="currentColor"></rect>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- the grid -->
      <div class="pc-grid" id="pc-grid" data-view="grid">
        {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
      </div>

      <!-- nothing matched -->
      <div class="pc-empty" data-filter-empty data-filter-target="#pc-projects" hidden>
        <svg class="pc-empty__icon" viewBox="0 0 48 48" width="44" height="44" aria-hidden="true">
          <circle cx="21" cy="21" r="13" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <path d="M30.5 30.5 42 42" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          <path d="M16 21h10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        <p class="pc-empty__h">No projects match that search.</p>
        <p class="pc-empty__p">
          Try a tool name — Tableau, Power BI, Python, SQL — or a business problem like
          forecasting, churn or reporting.
        </p>
        <button class="pill pill--ghost pill--sm pc-empty__btn" type="button" data-filter-clear data-filter-target="#pc-projects">
          Clear search
        </button>
      </div>
    </div>
  </section>

  <!-- ===================== CLOSING CTA ===================== -->
  <section class="tile tile--dark center pc-cta" id="portfolio-cta">
    <div class="inner center" data-stagger>
      <div class="eyebrow eyebrow--dark reveal">Next step</div>
      <h2 class="metrics__h2 reveal" style="color:#fff">
        Got a reporting problem that looks like one of these?
      </h2>
      <p class="hero__sub reveal">
        Send me the shape of it — the data you hold, the decision it should support, the deadline.
        You will get an honest read on scope and sequencing, and whether it is a dashboard problem
        or a data problem.
      </p>
      <div class="pc-cta__actions reveal">
        <a class="pill pill--primary" href="/#contact">Start a conversation</a>
        <a class="pill pill--ghost-dark" href="/services">See how I work</a>
      </div>
      <p class="pc-cta__note reveal">
        <a class="textlink textlink--dark" href="#portfolio-top">Back to the top of the portfolio</a>
      </p>
    </div>
  </section>
</Layout>
