---
// -----------------------------------------------------------------------------
// WorkTile — one featured-project tile on the home page.
// Structurally identical to the three hand-written .work sections it replaces:
// same tile tones, same .work / .work__text / .work__findings / .shot markup,
// same [data-tags] hook that site.ts's tool filter reads.
// -----------------------------------------------------------------------------
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** The lead tile — column layout, wider copy, larger figures. */
  feature?: boolean;
}

const { project, feature = false } = Astro.props;

const onDark = project.tone === 'dark' || project.tone === 'dark-3';
const caseHref = `/work/${project.slug}`;
const repo = project.links.find((l) => l.external);

// "Apple · 2025", but never "FIAP · Final-year project · FIAP".
const dateline = project.period.includes(project.org)
  ? project.period
  : `${project.org} · ${project.period}`;

const tileClass = [
  'tile',
  `tile--${project.tone}`,
  'work',
  onDark ? 'work--dark' : null,
  project.reverse ? 'work--reverse' : null,
  feature ? 'work--feature' : null,
]
  .filter(Boolean)
  .join(' ');

const textClass = feature ? 'work__text work__text--wide reveal' : 'work__text reveal';
const eyebrowClass = onDark ? 'eyebrow eyebrow--dark eyebrow--mono' : 'eyebrow eyebrow--mono';
const linkClass = onDark ? 'textlink textlink--dark work__link' : 'textlink work__link';
const fullLinkClass = onDark
  ? 'textlink textlink--dark work__fulllink reveal'
  : 'textlink work__fulllink reveal';
---

<section class={tileClass} data-tags={project.tags.join(' ')}>
  <div class={textClass}>
    <div class={eyebrowClass}>{project.eyebrow}</div>
    <h2 class="work__title">{project.title}</h2>
    <div class="work__meta">
      <span class="work__date">{dateline}</span>
      <span class="work__meta-sep" aria-hidden="true">·</span>
      <span class="work__read">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>{project.readMinutes} min read
      </span>
    </div>
    <div class="work__findings">
      {project.findings.map((f) => (
        <div class="finding">
          <span
            class="finding__n"
            data-counter-to={f.count !== undefined ? String(f.count) : undefined}
            data-counter-prefix={f.prefix}
            data-counter-suffix={f.suffix}
            data-counter-dec={f.count !== undefined && !Number.isInteger(f.count) ? '2' : '0'}
          >{f.value}</span>
          <span class="finding__t">{f.label}</span>
        </div>
      ))}
    </div>
    <a class={linkClass} href={caseHref}>Read the case study ›</a>
  </div>

  {feature ? (
    <div class="tableau-showcase reveal">
      <div class="shot">
        <img
          src={project.cover}
          alt={project.coverAlt}
          loading="lazy"
          decoding="async"
          width={project.coverWidth}
          height={project.coverHeight}
        />
      </div>
    </div>
  ) : (
    <a class="shot reveal" href={caseHref} aria-label={`Read the ${project.title} case study`}>
      <img
        src={project.cover}
        alt={project.coverAlt}
        loading="lazy"
        decoding="async"
        width={project.coverWidth}
        height={project.coverHeight}
      />
    </a>
  )}

  {repo && (
    <a class={fullLinkClass} href={repo.href} target="_blank" rel="noopener">{repo.label}</a>
  )}
</section>
