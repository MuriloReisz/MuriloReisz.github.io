---
import { site } from '../data/site';
const gh = site.socials.github;
const li = site.socials.linkedin;
---

<footer class="footer">
  <div class="footer__inner footer--min" data-stagger>
    <nav class="footer__icons reveal" aria-label="Social and contact links">
      <a class="footer__link" href={gh} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.6 8.21 11.16.6.11.82-.25.82-.56 0-.28-.01-1.02-.02-2-3.34.72-4.04-1.58-4.04-1.58-.55-1.36-1.34-1.73-1.34-1.73-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.21 1.84 1.21 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.58-2.67-.3-5.47-1.31-5.47-5.84 0-1.29.47-2.34 1.24-3.17-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.21a11.6 11.6 0 0 1 6.01 0c2.29-1.53 3.3-1.21 3.3-1.21.66 1.66.24 2.88.12 3.18.77.83 1.24 1.88 1.24 3.17 0 4.54-2.81 5.54-5.49 5.83.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.29 0 .31.22.68.83.56C20.56 21.88 24 17.49 24 12.29 24 5.78 18.63.5 12 .5z"></path></svg><span>GitHub</span></a>
      <a class="footer__link" href={li} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zm1.78 13.02H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path></svg><span>LinkedIn</span></a>
      <a class="footer__link" href={`mailto:${site.email}`}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 4.5h16c1.1 0 2 .9 2 2v11c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2v-11c0-1.1.9-2 2-2zm.3 2 7.05 5.13c.39.28.91.28 1.3 0L19.7 6.5H4.3zM20 8.04l-6.18 4.5a3 3 0 0 1-3.64 0L4 8.04v9.46h16V8.04z"></path></svg><span>Email</span></a>
      <a class="footer__link" href={`tel:${site.phone.replace(/\s+/g, '')}`}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.62 10.79a15.15 15.15 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.24 1.02l-2.21 2.2z"></path></svg><span>Phone</span></a>
      <a class="footer__link" href={site.resume} download><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2.75H7A1.75 1.75 0 0 0 5.25 4.5v15A1.75 1.75 0 0 0 7 21.25h10a1.75 1.75 0 0 0 1.75-1.75V7.5z"></path><path d="M14 2.75V7.5h4.75"></path></svg><span>Résumé</span></a>
    </nav>
    <nav class="footer__nav reveal" aria-label="Footer">
      <a href="/#about">About</a>
      <a href="/work">Portfolio</a>
      <a href="/playground">Playground</a>
      <a href="/#experience">Experience</a>
      <a href="/services">Analytics services</a>
      <a href="/ai-services">AI services</a>
      <a href="/meetup">Meetup</a>
      <a href="/#contact">Contact</a>
      <a href="/privacy">Privacy &amp; cookies</a>
      <a href="#" id="cookieSettings">Cookie settings</a>
    </nav>
    <p class="footer__contact reveal"><a href={`mailto:${site.email}`}>{site.email}</a> · <a href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a></p>
    <p class="footer__copy reveal">© {site.year} {site.brand} · {site.name} · {site.role}</p>
    <p class="footer__note reveal">Featured project datasets are recreated with artificial data for demonstration.</p>
  </div>
</footer>
