---
import '../styles/global.css';
// Enhancement layers — loaded after global.css so they win ties at equal specificity.
// Order matters: motion + shared primitives first, then the page-scoped namespaces.
import '../styles/motion.css';
import '../styles/ix.css';
import '../styles/work.css';
import '../styles/playground.css';
import '../styles/home.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Chrome from '../components/Chrome.astro';
import { site } from '../data/site';
import { projects } from '../data/projects';

interface Props {
  title?: string;
  description?: string;
  /** Social-share image, absolute path under /public. Must be a raster file. */
  ogImage?: string;
  /** Opt into the wider content measure (portfolio grid, case-study reader) */
  wide?: boolean;
}

const {
  title = `${site.brand} Portfolio`,
  description = site.tagline,
  ogImage = '/images/og-card.jpg',
  wide = false,
} = Astro.props;

// Astro.site comes from astro.config.mjs. Fall back gracefully so a missing/placeholder
// `site` never breaks the build — canonical + og:url are simply omitted in that case.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

// LinkedIn, X, Facebook and Slack all refuse SVG previews, and every project cover
// in this repo is an SVG — so anything vector falls back to the raster card rather
// than silently rendering no preview at all.
const shareImage = ogImage.endsWith('.svg') ? '/images/og-card.jpg' : ogImage;
const ogImageAbs = Astro.site ? new URL(shareImage, Astro.site).href : shareImage;

// Person schema helps search engines connect the site to the real profiles.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  email: `mailto:${site.email}`,
  telephone: site.phone,
  address: { '@type': 'PostalAddress', addressLocality: site.location },
  sameAs: [site.socials.github, site.socials.linkedin],
  description: site.tagline,
};

// The ⌘K palette's case-study entries, projected here at build time. Keeping
// this out of src/scripts/site.ts is what stops the whole projects dataset —
// case-study prose, galleries, FAQs, ~46 KB — from shipping in the client
// bundle of every page just to power a search index.
const cmdkProjects = projects.map((p) => ({
  label: p.title,
  href: `/work/${p.slug}`,
  kw: `case study project ${p.org} ${p.tags.join(' ')} ${p.eyebrow}`.toLowerCase(),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      /* Set theme before first paint to avoid flash */
      (function () {
        try {
          document.documentElement.classList.add('js');
          var t = localStorage.getItem('theme');
          if (!t) t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
          if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    {canonical && <link rel="canonical" href={canonical} />}

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content="en_IE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.role}`} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Match the browser chrome to the active theme -->
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <!-- iOS ignores SVG here, so this one is a raster -->
    <link rel="apple-touch-icon" sizes="180x180" href="/images/apple-touch-icon.png" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(personLd)} />
  </head>
  <body data-measure={wide ? 'wide' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- Fixed-position overlays last: keeps the page h1 first in source order
         and puts this chrome at the end of the focus order. -->
    <Chrome />
    <script type="application/json" id="cmdkProjects" set:html={JSON.stringify(cmdkProjects)} is:inline />
    <script src="../scripts/site.ts"></script>
    <script src="../scripts/motion.ts"></script>
    <script src="../scripts/motion2.ts"></script>
    <script src="../scripts/widgets.ts"></script>
    <script src="../scripts/demos.ts"></script>
    <script src="../scripts/home.ts"></script>
  </body>
</html>
