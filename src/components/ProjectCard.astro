---
// ---------------------------------------------------------------------------
// ProjectCard — one project in the /work grid.
//
// The root is a <section data-tags> so the existing site.ts tool filter picks
// it up, and a [data-filter-item] so the widgets.ts collection (search + sort
// + view) drives the same element. The two compose: site.ts toggles the
// .work--hidden class, widgets.ts sets inline display.
//
// One keyboard target per card: the title link. It is stretched over the whole
// card in CSS, so the media, the stats and the "Read the case study" affordance
// are all deliberately non-interactive.
// ---------------------------------------------------------------------------
import { brandChipStyle, type Project } from '../data/projects';
import ProjectDash from './ProjectDash.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

const href = `/work/${project.slug}/`;
const titleId = `pc-t-${project.slug}`;

// Everything the search box should be able to match on, flattened once at build
// time so the client never has to walk the DOM for it.
const filterText = [
  project.title,
  project.eyebrow,
  project.org,
  project.period,
  project.summary,
  project.role,
  ...project.stack,
  ...project.tags,
]
  .join(' ')
  .toLowerCase();

/* The card leads on impact, not on narrative findings: value and time are the
   two questions a visitor scanning the grid is actually asking, and quality
   fills the third slot the layout already had. Same three slots on every card,
   which is what lets the grid be compared down a column. */
const stats = [project.impact.value, project.impact.time, project.impact.quality];

/** Decimals from the source number, so 94.5 does not animate up to "94". */
const dec = (n: number) => String(n).split('.')[1]?.length ?? 0;
---

<section
  class="pc-card hud-frame hud-frame--hover"
  id={`pc-${project.slug}`}
  data-filter-item
  data-tags={project.tags.join(' ')}
  data-filter-text={filterText}
  data-sort-year={String(project.year)}
  data-sort-title={project.title}
  data-tilt
  data-tilt-max="4"
  aria-labelledby={titleId}
  style={`--pc-i:${index}`}
>
  <div class="pc-card__media" data-spotlight>
    <!-- A compact dashboard mock rendered from the project's own figures
         stands in for a cover image: static, no observers, brand colours. -->
    <ProjectDash project={project} variant="compact" />
    <!-- The three findings, revealed on hover/focus. Pointer-only. -->
    <ul class="pc-card__peek" aria-hidden="true">
      {project.findings.map((f) => (
        <li><b>{f.value}</b><span>{f.label}</span></li>
      ))}
    </ul>
    <span
      class="pc-card__badge"
      style={brandChipStyle(project.brand)}
    >{project.brand.wordmark}</span>
    {project.illustrative && <span class="pc-card__illus">Illustrative</span>}
    <span class="pc-card__idx hud-label" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
  </div>

  <div class="pc-card__body">
    <div class="pc-card__eyebrow eyebrow eyebrow--mono">{project.eyebrow}</div>

    <h2 class="pc-card__title" id={titleId}>
      <a class="pc-card__link" href={href}>{project.title}</a>
    </h2>

    <p class="pc-card__meta">
      <span class="pc-card__org">{project.org}</span>
      <span class="pc-card__sep" aria-hidden="true">·</span>
      <span class="pc-card__period">{project.period}</span>
      <span class="pc-card__sep" aria-hidden="true">·</span>
      <span class="pc-card__read">{project.readMinutes} min read</span>
    </p>

    <p class="pc-card__summary">{project.summary}</p>

    <dl class="pc-card__stats">
      {
        stats.map((f) => (
          <div class="pc-stat">
            <dt class="pc-stat__l">{f.label}</dt>
            <dd class="pc-stat__v">
              {f.count !== undefined ? (
                <span
                  class="pc-stat__n"
                  data-counter-to={String(f.count)}
                  data-counter-prefix={f.prefix}
                  data-counter-suffix={f.suffix}
                  data-counter-dec={String(dec(f.count))}
                >
                  {f.value}
                </span>
              ) : (
                <span class="pc-stat__n">{f.value}</span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <ul class="pc-card__stack" aria-label={`Stack used on ${project.title}`}>
      {project.stack.map((tool) => <li class="tag pc-card__tag">{tool}</li>)}
    </ul>

    <p class="pc-card__cta" aria-hidden="true">
      Read the case study <span class="pc-card__arrow">→</span>
    </p>
  </div>
</section>

<style>
  .pc-card__peek {
    position: absolute;
    inset: 0;
    z-index: 1;
    margin: 0;
    padding: 14px 16px;
    list-style: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    background: rgba(10, 10, 12, 0.88);
    color: #fff;
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }
  .pc-card__peek li { display: grid; gap: 2px; }
  .pc-card__peek b { font-family: var(--font-display); font-size: 17px; font-weight: 700; letter-spacing: -0.3px; color: #c4b5fd; }
  .pc-card__peek span { font-size: 12px; line-height: 1.35; color: #d2d2d7; }
  @media (hover: hover) {
    .pc-card:hover .pc-card__peek,
    .pc-card:focus-within .pc-card__peek { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) { .pc-card__peek { transition: none; } }
</style>
