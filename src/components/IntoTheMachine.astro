---
// IntoTheMachine — the site's cold open: a procedural point-cloud
// impression of a person at a desk (no real 3D scan — coded from
// primitive shapes in src/scripts/pointcloud.ts), rendered with
// Three.js. It auto-rotates continuously; scrolling through the tall
// .itm-wrap track dollies the camera toward the monitor while a violet
// veil fades in, so the visitor appears to fly through the screen and
// land on the real hero underneath.
//
// Three.js is ~528 KB, so it is loaded by a *dynamic* import from a
// component-scoped <script> rather than a static one. That means it is only
// fetched when the intro is actually going to play: not on other pages, not
// under prefers-reduced-motion, and not for a visitor who has already seen it
// or skipped it. A static <script src> would have downloaded it every time
// regardless, which is what used to happen on every single homepage visit.
//
// If WebGL is unavailable the empty .itm-fallback panel underneath (sat behind
// the canvas) is what's left — plain black, same as the canvas's own
// background.
import '../styles/intro.css';
import { site } from '../data/site';
import { projects } from '../data/projects';
import { techStack } from '../data/extras';

// The HUD readout. Every line is derived from real site data or is a plain
// statement of fact about how this page is built — it used to read
// "Commits Today: 14 / Bugs Fixed: 231 / Last Deploy: 2 min ago", which looks
// like a live telemetry feed and was invented. A decorative HUD is fine; one
// that fabricates activity metrics is not, on a site whose whole pitch is
// numbers you can trust.
const stats = [
  `Case Studies: ${projects.length}`,
  `Tools In Use: ${techStack.length}`,
  'Framework: none',
  'Renderer: WebGL point cloud',
  'Geometry: procedural, no 3D scan',
  'Analytics: none',
  `Location: ${site.location}`,
];
---

<!-- Pre-paint skip decision. Inline and synchronous, ahead of the section, for
     the same reason the theme script in Layout.astro is: deciding after paint
     would show 240vh of black cold open and then yank it away. -->
<script is:inline>
  (function () {
    try {
      var seen = localStorage.getItem('itm:seen');
      var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (seen || reduced) document.documentElement.setAttribute('data-itm', 'skip');
    } catch (e) {
      /* Private browsing can throw on localStorage. Play the intro; it is the
         graceful direction to fail in. */
    }
  })();
</script>

<section class="itm-wrap" data-into-pc aria-hidden="true" role="presentation">
  <div class="itm-stage">
    <div class="itm-stats">
      {stats.map((s) => <p class="itm-stat">{s}</p>)}
    </div>

    <div class="itm-fallback"></div>

    <canvas class="itm-canvas"></canvas>

    <div class="itm-veil"></div>

    <p class="itm-clock" data-itm-clock aria-hidden="true">&nbsp;</p>

    <p class="itm-caption">
      {site.name} &nbsp;|&nbsp; {site.role}
      <br />
      GitHub &nbsp;|&nbsp; LinkedIn &nbsp;|&nbsp; Email
    </p>

    <p class="itm-hint">Scroll to enter <span aria-hidden="true">&#8595;</span></p>

    <!-- Not aria-hidden like the rest of the stage: this is the one thing in
         here a visitor may genuinely need to operate. -->
    <button class="itm-skip" type="button" data-itm-skip aria-hidden="false">Skip intro</button>
  </div>
</section>

<script>
  /* Load Three.js only if the intro is going to run. The skip attribute is set
     by the inline script above, before this module is evaluated. */
  const root = document.documentElement;
  const wrap = document.querySelector('.itm-wrap');

  /** Take the intro off the page and remember not to show it again. */
  function skipIntro(scroll: boolean) {
    root.setAttribute('data-itm', 'skip');
    try { localStorage.setItem('itm:seen', '1'); } catch {}
    if (scroll) {
      /* The tall track has just collapsed, so the hero is already at the top of
         the document — jump there rather than animating through nothing. */
      window.scrollTo({ top: 0, behavior: 'auto' });
    }
  }

  if (wrap && root.getAttribute('data-itm') !== 'skip') {
    import('../scripts/pointcloud.ts');

    document.querySelector('[data-itm-skip]')?.addEventListener('click', () => skipIntro(true));

    /* Mark it seen once the visitor has scrolled through the portal, so a
       returning visitor lands straight on the hero. Scrolling past it counts as
       having watched it; leaving early does not. */
    const seenAt = () => {
      const r = wrap.getBoundingClientRect();
      if (r.bottom <= window.innerHeight * 1.05) {
        try { localStorage.setItem('itm:seen', '1'); } catch {}
        removeEventListener('scroll', seenAt);
      }
    };
    addEventListener('scroll', seenAt, { passive: true });
  }
</script>
