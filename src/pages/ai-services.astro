          <option value="Implementation (from €1,500)">Implementation (from €1,500)</option>
          <option value="AI Concierge (€999/mo)">AI Concierge (€999/mo)</option>
          <option value="Not sure yet">Not sure yet</option>
        </select>
        <select class="cta__field" name="timeline" aria-label="Timeline (optional)">
          <option value="">Timeline (optional)</option>
          <option value="Now / this month">Now / this month</option>
          <option value="This quarter">This quarter</option>
          <option value="Just exploring">Just exploring</option>
        </select>
        <textarea class="cta__field" name="message" placeholder="What eats most of your time right now, and what you’ve tried so far." aria-label="Message" required></textarea>
        <span class="cta__err" data-err="message" aria-live="polite"></span>
        <button class="pill pill--ghost-dark cta__submit" type="submit">Send a message</button>
        <div class="cta__status" id="contactStatusAI" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>
</Layout>
