---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';

const bookHref = site.calendlyUrl || '#ai-services-book';
const bookAttrs = site.calendlyUrl ? { target: '_blank', rel: 'noopener' } : {};
---

<Layout title="AI services">

  <!-- ===================== Pricing ladder — assessment hero + two step cards ===================== -->
  <section class="tile tile--black center" id="ai-services-plans-v2" data-spotlight>
    <div class="offers-bg-grid" aria-hidden="true"></div>
    <div class="offers-bg-dots reveal" aria-hidden="true" style="transition-delay:3.2s"></div>
    <div class="offers-bg-topglow reveal" aria-hidden="true" style="transition-delay:3s"></div>

    <div class="inner reveal" style="position:relative;z-index:1;transition-delay:0s">
      <div class="eyebrow eyebrow--dark" data-reveal-chars>AI services</div>
      <h1 class="metrics__h2" data-reveal-words style="color:#fff;max-width:820px;margin-left:auto;margin-right:auto;font-size:clamp(29px,4.2vw,44px)">Your team loses hours every week to work AI can already do.<br />Let&rsquo;s find them and take them back.</h1>
    </div>

    <div class="oa">
      <!-- STEP 1 — assessment hero -->
      <div class="oa-hero reveal" style="transition-delay:0.5s">
        <div class="oa-hero__main">
          <h2 class="oa-hero__title">AI Opportunity Assessment</h2>
          <p class="oa-hero__desc">Find at least 5 hours of recurring work AI can remove from your week &mdash; and get a prioritised plan showing exactly what to do next.</p>
          <div class="oa-price"><span class="oa-price__cur">&euro;</span>500<span class="oa-price__suf">one-off</span></div>
          <a class="oa-cta oa-cta--primary" data-magnetic data-magnetic-strength="8" href={bookHref} {...bookAttrs}>Book your assessment</a>
          <a class="oa-samplelink" href="#ai-services-report">View a sample report <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
        </div>
        <div class="oa-hero__side">
          <div class="oa-side__head">What you get</div>
          <ul class="oa-checks">
            <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>45-minute workflow audit</span></li>
            <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>3&ndash;7 tools and automations matched to your work</span></li>
            <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Cost, setup effort and hours saved for each</span></li>
            <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Personalised 4-day action plan</span></li>
            <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>30-minute results walkthrough</span></li>
          </ul>
        </div>
        <div class="oa-morewrap">
          <button class="oa-learn" type="button" aria-expanded="false" aria-controls="oa-more-assess"><span>Learn more</span> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></button>
          <div class="oa-more" id="oa-more-assess"><div class="oa-more__clip"><div class="oa-more__pad">
            <p class="oa-more__best"><strong>Best for:</strong> a busy owner or team lead who knows they should be using AI, but has no time to test 40 tools to find the three that matter.</p>
            <p class="oa-more__payoff">Reclaim 5&ndash;10 hours a week, and most clients earn it back in the first week.</p>
            <div>
              <div class="oa-sublabel">Includes</div>
              <ul class="oa-more__list">
                <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>A 45-minute discovery call where I pull out exactly where your week goes</span></li>
                <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Three to seven off-the-shelf AI tools matched to your specific bottlenecks</span></li>
                <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>For each tool: what it fixes, the monthly cost, setup time, and hours saved</span></li>
                <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>A short written report with a 4-day quick-start plan and the ROI in <em>your</em> numbers</span></li>
                <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>A 30-minute review call to walk it through together</span></li>
              </ul>
            </div>
          </div></div></div>
        </div>
        <div class="oa-hero__guar">
          <span class="oa-hero__guar-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg></span>
          <div>
            <div class="oa-hero__guar-t">Find 5+ hours a week or your money back.</div>
            <div class="oa-hero__guar-d">&euro;500 credited in full towards an implementation.</div>
          </div>
        </div>
      </div>

      <!-- STEPS 2 & 3 -->
      <div class="oa-steps">
        <div class="oa-rail" aria-hidden="true"></div>

        <div class="oa-block reveal" style="transition-delay:0.95s">
          <div class="oa-divlabel">If you want it built</div>
          <div class="oa-step" data-tilt data-tilt-max="4">
            <span class="oa-node" aria-hidden="true">2</span>
            <div class="oa-step__main">
              <h3 class="oa-step__title">Implementation</h3>
              <p class="oa-step__desc">Your chosen workflow built, tested and handed over.</p>
              <div class="oa-sublabel">Build types</div>
              <dl class="oa-buildlist">
                <div class="oa-buildrow"><dt>AI tool &amp; knowledge-system setup</dt><dd>&euro;1,500&ndash;&euro;3,000</dd></div>
                <div class="oa-buildrow"><dt>Custom workflow automation</dt><dd>&euro;3,000&ndash;&euro;8,000+</dd></div>
              </dl>
              <a class="oa-morelink" href="#ai-services-frameworks">See examples below <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></a>
            </div>
            <div class="oa-step__side">
              <div class="oa-price"><span class="oa-price__cur">&euro;</span>1,500&ndash;<span class="oa-price__cur">&euro;</span>8,000</div>
              <div class="oa-price__per">fixed scope</div>
              <a class="oa-cta oa-cta--ghost" data-magnetic href={bookHref} {...bookAttrs}>Discuss a build <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
              <p class="oa-step__foot">Your assessment fee comes off the price.</p>
            </div>
            <div class="oa-morewrap">
              <button class="oa-learn" type="button" aria-expanded="false" aria-controls="oa-more-impl"><span>Learn more</span> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></button>
              <div class="oa-more" id="oa-more-impl"><div class="oa-more__clip"><div class="oa-more__pad">
                <p class="oa-more__best"><strong>Best for:</strong> you&rsquo;ve seen the plan, you want the time back now, and you&rsquo;d rather not spend your evenings wiring up tools yourself.</p>
                <div>
                  <div class="oa-sublabel">Includes</div>
                  <ul class="oa-more__list">
                    <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Automations that run the repetitive multi-step work for you</span></li>
                    <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>A knowledge system or custom GPT trained on your own documents</span></li>
                    <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Custom skills for a process that&rsquo;s specific to how you work</span></li>
                    <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Process cleanup first, so you&rsquo;re not automating a mess</span></li>
                    <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Your &euro;500 assessment fee credited against the work</span></li>
                  </ul>
                </div>
              </div></div></div>
            </div>
          </div>
        </div>

        <div class="oa-block reveal" style="transition-delay:1.2s">
          <div class="oa-divlabel">If you want to keep improving</div>
          <div class="oa-step" data-tilt data-tilt-max="4">
            <span class="oa-node" aria-hidden="true">3</span>
            <div class="oa-step__main">
              <h3 class="oa-step__title">Ongoing AI Support</h3>
              <p class="oa-step__desc">One defined workflow improved or automated each month, with senior support between sessions.</p>
              <div class="oa-sublabel">Includes</div>
              <ul class="oa-checks">
                <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Two working sessions</span></li>
                <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Async support within 1 business day</span></li>
                <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Running documentation of everything built</span></li>
              </ul>
              <a class="oa-morelink" href="#ai-services-concierge">See more <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></a>
            </div>
            <div class="oa-step__side">
              <div class="oa-price"><span class="oa-price__cur">&euro;</span>999<span class="oa-price__suf">/ month</span></div>
              <div class="oa-price__per">Month-to-month &middot; capped availability</div>
              <a class="oa-cta oa-cta--ghost" data-magnetic href={bookHref} {...bookAttrs}>Check availability <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></a>
            </div>
            <div class="oa-morewrap">
              <button class="oa-learn" type="button" aria-expanded="false" aria-controls="oa-more-support"><span>Learn more</span> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></button>
              <div class="oa-more" id="oa-more-support"><div class="oa-more__clip"><div class="oa-more__pad">
                <p class="oa-more__best"><strong>Best for:</strong> a founder or team that wants to keep finding and fixing time drains every month, without hiring for it.</p>
                <p class="oa-more__payoff">A fresh bottleneck found and automated every month.</p>
                <div>
                  <div class="oa-sublabel">Includes</div>
                  <ul class="oa-more__list">
                    <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Two 45-minute calls a month, you share your screen and I coach you live</span></li>
                    <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>Always-on access during the month, 12-business-hour response</span></li>
                    <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>One workflow audited, trimmed and automated on every call</span></li>
                    <li class="oa-check"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg><span>A running record of everything we build, so the value stays visible</span></li>
                  </ul>
                </div>
                <p class="oa-more__note"><strong>Good to know:</strong> larger one-off builds beyond the calls are scoped separately.</p>
              </div></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== BUILD FRAMEWORKS ===================== -->
  <section class="tile center" id="ai-services-frameworks">
    <div class="inner center sreveal">
      <div class="eyebrow">Frameworks</div>
      <h2 class="metrics__h2" data-reveal-words style="max-width:660px"><span style="color:var(--color-ink-48)">Built to automate.</span><br />Designed to perform.</h2>
      <p class="hero__sub" style="max-width:660px">Each framework is a building block of your AI infrastructure, designed to automate, connect, and scale your operations with precision.</p>
    </div>

    <div class="fw">
      <!-- Framework 01 — AI Receptionist -->
      <div class="fw__row sreveal">
        <div class="fw__visual">
          <div class="fw__stage">
            <div class="fw__mock fw__mock--voice" data-mock>
              <div class="fw__voice-top">
                <span class="fw__wave" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
                <span>AI&nbsp;Voice</span>
                <span class="fw__voice-time">00:00</span>
              </div>
              <div class="fw__feed" data-feed>
                <div class="fw__line" data-step><span class="fw__line-hd"><span class="fw__line-av fw__line-av--logo" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8 L11 25 L16 14 L21 25 L27 8" stroke="currentColor" stroke-width="3"></path><path d="M6.5 23 C 11 22, 14 18, 18 16 S 25 10.5, 28.5 6" stroke="#a78bfa" stroke-width="2.8"></path><path d="M23.8 5.6 L29 5 L28.6 10.2" stroke="#a78bfa" stroke-width="2.8"></path></svg></span><span class="fw__line-who">Riverside Auto</span></span><p class="fw__line-txt">Thanks for calling Riverside Auto! Who am I speaking with?</p></div>
                <div class="fw__line fw__line--caller" data-step><span class="fw__line-hd"><span class="fw__line-av" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span><span class="fw__line-who">Patrick</span></span><p class="fw__line-txt">Hi, it&rsquo;s Patrick.</p></div>
                <div class="fw__line" data-step><span class="fw__line-hd"><span class="fw__line-av fw__line-av--logo" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8 L11 25 L16 14 L21 25 L27 8" stroke="currentColor" stroke-width="3"></path><path d="M6.5 23 C 11 22, 14 18, 18 16 S 25 10.5, 28.5 6" stroke="#a78bfa" stroke-width="2.8"></path><path d="M23.8 5.6 L29 5 L28.6 10.2" stroke="#a78bfa" stroke-width="2.8"></path></svg></span><span class="fw__line-who">Riverside Auto</span></span><p class="fw__line-txt">Great to meet you, Patrick. Are you calling about your service booking?</p></div>
                <div class="fw__line fw__line--caller" data-step><span class="fw__line-hd"><span class="fw__line-av" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg></span><span class="fw__line-who">Patrick</span></span><p class="fw__line-txt">Yeah, is tomorrow morning still good?</p></div>
                <div class="fw__line" data-step><span class="fw__line-hd"><span class="fw__line-av fw__line-av--logo" aria-hidden="true"><svg viewBox="0 0 32 32" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8 L11 25 L16 14 L21 25 L27 8" stroke="currentColor" stroke-width="3"></path><path d="M6.5 23 C 11 22, 14 18, 18 16 S 25 10.5, 28.5 6" stroke="#a78bfa" stroke-width="2.8"></path><path d="M23.8 5.6 L29 5 L28.6 10.2" stroke="#a78bfa" stroke-width="2.8"></path></svg></span><span class="fw__line-who">Riverside Auto</span></span><p class="fw__line-txt">You&rsquo;re booked in for 10 AM tomorrow. I&rsquo;ll text a reminder tonight.</p></div>
              </div>
              <div class="fw__success" data-success>
                <span class="fw__success-ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                <div class="fw__success-h">Appointment confirmed</div>
                <div class="fw__success-s">Tomorrow, 10 AM</div>
              </div>
              <div class="fw__voice-end">
                <span class="fw__endbtn" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></span>
              </div>
            </div>
          </div>
        </div>
        <div class="fw__text">
          <div class="fw__label">AI Receptionist</div>
          <h3 class="fw__title">Intelligent voice agents that engage, qualify, and convert in real time.</h3>
          <div class="fw__grid">
            <div class="fw__feat" data-tilt data-tilt-max="5"><span class="fw__feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg></span><div class="fw__feat-h">Natural Conversations</div><p class="fw__feat-p">Understands context and tone, providing human-like voice responses instantly.</p></div>
            <div class="fw__feat" data-tilt data-tilt-max="5"><span class="fw__feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg></span><div class="fw__feat-h">Smart Lead Routing</div><p class="fw__feat-p">Identifies caller needs and directs them to the right team automatically.</p></div>
            <div class="fw__feat" data-tilt data-tilt-max="5"><span class="fw__feat-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline></svg></span><div class="fw__feat-h">Real-Time Insights</div><p class="fw__feat-p">Logs every call, sentiment, and action directly into your dashboard for review.</p></div>
