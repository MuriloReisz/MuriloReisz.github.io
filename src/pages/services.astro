---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import RoiCalculator from '../components/RoiCalculator.astro';

const bookHref = site.calendlyUrl || '#services-book';
const bookAttrs = site.calendlyUrl
  ? { href: site.calendlyUrl, target: '_blank', rel: 'noopener' }
  : { href: '#services-book' };
---

<Layout title="Analytics services">

  <section class="tile tile--black center" id="services-plans" data-spotlight>
    <div class="offers-bg-grid" aria-hidden="true"></div>
    <div class="offers-bg-dots reveal" aria-hidden="true" style="transition-delay:3.2s"></div>
    <div class="offers-bg-topglow reveal" aria-hidden="true" style="transition-delay:3s"></div>
    <div class="inner center reveal" style="position:relative;z-index:1;transition-delay:0s">
      <div class="eyebrow eyebrow--dark" data-reveal-chars>How I can help</div>
      <h1 class="metrics__h2" style="color:#fff" data-reveal-words>When leadership can’t trust the numbers, decisions stall.<br />I turn manual reporting, forecasts and approvals into systems you can rely on.</h1>
      <p class="hero__sub" style="color:#9ca3af;max-width:720px;margin-left:auto;margin-right:auto">A paid diagnostic scopes the work, a fixed-scope build ships it on your live data, and an optional retainer keeps it running. Senior delivery, fixed scope, no lock-in.</p>
    </div>
    <div class="inner--grid offers">

      <div class="offer reveal" data-tilt data-tilt-max="3" style="transition-delay:1.5s">
        <div class="offer__name">The Diagnostic</div>
        <p class="offer__tag">A paid, one-week audit that pinpoints where manual reporting or a fragile forecast is costing you, and exactly what to build.</p>
        <p class="offer__for"><strong>Best for:</strong> a COO, operations or finance leader who suspects a manual report, a fragile forecast or a hand-run workflow is leaking time, money or trust, but hasn’t quantified it.</p>
        <div class="offer__price"><span class="offer__pre">from</span><span class="offer__cur">€</span>1,500</div>
        <div class="offer__period">credited in full against a build &middot; ~1 week</div>
        <a class="offer__cta offer__cta--default" href={bookHref} data-magnetic>Request a diagnostic</a>
        <div class="offer__list">
          <div class="offer__list-head">Includes</div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>A written diagnosis of the two or three highest-cost blind spots in your data and process</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>The cost of inaction quantified in <em>your</em> numbers: hours, rework and revenue at risk</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>One working sample built on a slice of your own live data</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>A data-readiness assessment and written acceptance criteria for the build</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>A scoped, fixed-price roadmap, so you decide the build with real numbers</span></div>
        </div>
        <p class="offer__excl"><strong>Not included:</strong> the production build, live deployment or ongoing support. Those are the build and the retainer.</p>
      </div>

      <div class="offer offer--featured reveal" data-tilt data-tilt-max="3" style="transition-delay:1.85s">
        <span class="offer__badge">Most common</span>
        <div class="offer__name">The Build</div>
        <p class="offer__tag">One production system your team trusts, built on your live data against a written spec and validated before handover. Three outcomes:</p>
        <p class="offer__for"><strong>Trusted Executive Dashboard</strong> &middot; <strong>Forecast / Reporting Rebuild</strong> &middot; <strong>One Automated Workflow</strong> (with governance).</p>
        <div class="offer__price"><span class="offer__pre">from</span><span class="offer__cur">€</span>8,000</div>
        <div class="offer__period">fixed scope, value-priced &middot; automation from €12,000</div>
        <a class="offer__cta offer__cta--featured" href={bookHref} data-magnetic>Book a discovery call</a>
        <div class="offer__list">
          <div class="offer__list-head">Includes</div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>Diagnose &rarr; design &rarr; build on your live data, scoped against the diagnostic’s written acceptance criteria</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>A UAT-and-hardening phase against real edge cases, validated before handover instead of a single vague “revision round”</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>Documented refresh pipeline, runbooks, and monitoring with alerting</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>Source in your own repository, plus a defined post-handover support window. No lock-in</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>A change-order clause and data-quality precondition, so scope and price hold</span></div>
        </div>
        <p class="offer__excl"><strong>Not included:</strong> work outside the written spec (handled by change order) and ongoing maintenance (that’s the retainer).</p>
      </div>

      <div class="offer reveal" data-tilt data-tilt-max="3" style="transition-delay:2.2s">
        <div class="offer__name">The Retainer</div>
        <p class="offer__tag">Your systems kept live, monitored and evolving, senior capacity without a full-time hire.</p>
        <p class="offer__for"><strong>Best for:</strong> an organisation that wants its dashboards, forecasts and automations kept reliable and improving, without hiring a €55k+ salaried analyst.</p>
        <div class="offer__price"><span class="offer__pre">from</span><span class="offer__cur">€</span>2,000</div>
        <div class="offer__period">per month &middot; minimum 3 months</div>
        <a class="offer__cta offer__cta--default" href={bookHref} data-magnetic>Discuss ongoing support</a>
        <div class="offer__list">
          <div class="offer__list-head">Includes</div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>Pipelines and dashboards kept live, with monitoring and alerting</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>A monthly decision report: three to five prioritised insights with recommendations</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>A capped monthly build block for changes and small new work</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>A scheduled review call and a defined response window</span></div>
          <div class="offer__li"><span class="offer__li-dot"></span><span>Priced as a fraction of a loaded senior-analyst salary, so we’re not counting hours</span></div>
        </div>
        <p class="offer__excl"><strong>Not included:</strong> large new builds beyond the capped block, which are scoped as fresh projects.</p>
      </div>

    </div>
    <p class="offer-note reveal" style="position:relative;z-index:1;transition-delay:2.5s">Not sure which fits? <a href={bookHref}><strong>Book a discovery call</strong></a> and I’ll tell you honestly whether I can help. Engagements start with a paid diagnostic and run into four and five figures for a build.<small>Indicative “from” prices; each build is scoped and quoted from your diagnostic.</small></p>
  </section>

  <!-- ===================== PROBLEM / COST OF INACTION (dark) ===================== -->
  <section class="tile tile--dark center">
    <div class="inner center sreveal">
      <div class="eyebrow eyebrow--dark">The cost of untrusted numbers</div>
      <h2 class="metrics__h2" style="color:#fff" data-reveal-words>You rarely lose money on the reports you know are wrong. You lose it on the ones you <span style="color:var(--color-primary-on-dark)">trust</span>, and shouldn’t.</h2>
      <p class="hero__sub" style="color:#9ca3af;max-width:640px;margin-left:auto;margin-right:auto">When reporting is held together by hand and approvals run on memory, leadership ends up deciding on numbers no one fully trusts. Here’s how most teams cope:</p>
    </div>
    <div class="inner">
      <div class="cope__grid" data-stagger>
        <article class="cope__card sreveal" data-tilt data-tilt-max="4">
          <div class="cope__top">
            <span class="cope__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M3 12a9 9 0 0 1 15-6.7L21 8" /><path d="M21 3v5h-5" /><path d="M21 12a9 9 0 0 1-15 6.7L3 16" /><path d="M3 21v-5h5" /></svg>
            </span>
            <span class="cope__idx" aria-hidden="true">01</span>
          </div>
          <h3 class="cope__title">Stay manual</h3>
          <p class="cope__desc">Hours re-keyed every week, a month-end that breaks when one person is off, and numbers leadership never fully trusts.</p>
          <div class="cope__cost">
            <span class="cope__cost-label">The cost:</span>
            <span class="cope__cost-value">Hours lost every week</span>
          </div>
        </article>
        <article class="cope__card sreveal" data-tilt data-tilt-max="4">
          <div class="cope__top">
            <span class="cope__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M19 8v6" /><path d="M22 11h-6" /></svg>
            </span>
            <span class="cope__idx" aria-hidden="true">02</span>
          </div>
          <h3 class="cope__title">Hire a full-time analyst</h3>
          <p class="cope__desc">A €55k+ salary, plus payroll and the effort of managing someone, when the work that actually needs a senior analyst only comes up a few days a month.</p>
          <div class="cope__cost">
            <span class="cope__cost-label">The cost:</span>
            <span class="cope__cost-value cope__cost-value--num">€55k+ a year</span>
          </div>
        </article>
        <article class="cope__card sreveal" data-tilt data-tilt-max="4">
          <div class="cope__top">
            <span class="cope__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" width="24" height="24"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z" /><path d="M12 9v4" /><path d="M12 17h.01" /></svg>
            </span>
            <span class="cope__idx" aria-hidden="true">03</span>
          </div>
          <h3 class="cope__title">Do nothing</h3>
          <p class="cope__desc">Decisions keep getting made on shaky numbers, risk compounds, and the manual work quietly scales with the business.</p>
          <div class="cope__cost">
            <span class="cope__cost-label">The cost:</span>
            <span class="cope__cost-value">Compounding risk</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ===================== PROOF / FLAGSHIP CASE STUDY + AUTHORITY (parchment) ===================== -->
  <section class="tile tile--parchment center">
    <div class="inner center sreveal" data-stagger>
      <div class="eyebrow sreveal">Proof</div>
      <h2 class="metrics__h2" style="color:var(--color-ink)" data-reveal-words>Proven at enterprise scale.</h2>
      <p class="proofcs__lead sreveal">The job is always the same: take reporting that lives in someone’s head or a fragile spreadsheet and turn it into a system people can trust.</p>
      <div class="proofcs__grid sreveal">
        <article class="proofcs__card" data-tilt data-tilt-max="3">
          <header class="proofcs__head">
            <h3 class="proofcs__label">Enterprise sales analytics · Apple (CEMEA)</h3>
          </header>
          <p class="proofcs__desc">Browser-based automation with Playwright plus interactive Tableau dashboards and predictive models — turning large-scale, cross-regional sales data into trusted reporting for the CEMEA Sales BPR &amp; Systems team, and building automation that removes hours of manual work for freelance clients.</p>
          <div class="proofcs__metrics">
            <div class="proofcs__metric">
              <span class="proofcs__n">−80%</span>
              <span class="proofcs__ml">manual effort, via Python &amp; RPA</span>
            </div>
            <div class="proofcs__metric">
              <span class="proofcs__n">Terabytes</span>
              <span class="proofcs__ml">of data engineered into BigQuery</span>
            </div>
            <div class="proofcs__metric">
              <span class="proofcs__n">CEMEA</span>
              <span class="proofcs__ml">cross-regional sales visibility</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="tile tile--white center" id="services-compare">
    <div class="inner center sreveal">
      <div class="eyebrow">Compare</div>
      <h2 class="metrics__h2" style="color:var(--color-ink)" data-reveal-words>Which build do you need?</h2>
    </div>
    <div class="cmp sreveal">
      <div class="cmp__scroll">
        <table class="cmp__table">
          <thead class="cmp__thead">
            <tr>
              <th class="cmp__corner" scope="col">What’s included</th>
              <th class="cmp__plan" scope="col">
                <button class="cmp__plan-btn" type="button" data-col="1" aria-pressed="false"><span class="cmp__plan-name">Forecast &amp; Reporting Rebuild</span><span class="cmp__plan-price">from €8,000</span></button>
              </th>
              <th class="cmp__plan is-sel" scope="col">
                <button class="cmp__plan-btn" type="button" data-col="2" aria-pressed="true"><span class="cmp__plan-name">Trusted Executive Dashboard</span><span class="cmp__plan-price">from €8,000</span><span class="cmp__plan-badge">Most common</span></button>
              </th>
              <th class="cmp__plan" scope="col">
                <button class="cmp__plan-btn" type="button" data-col="3" aria-pressed="false"><span class="cmp__plan-name">One Automated Workflow</span><span class="cmp__plan-price">from €12,000</span></button>
              </th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="cmp__feat">A live dashboard leadership relies on</td>
              <td class="cmp__cell" data-col="1" aria-label="Not included"><span class="cmp__dash" aria-hidden="true"></span></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell" data-col="3" aria-label="Not included"><span class="cmp__dash" aria-hidden="true"></span></td>
            </tr>
            <tr>
              <td class="cmp__feat">A fragile forecast or manual report rebuilt and made auditable</td>
              <td class="cmp__cell" data-col="1" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Not included"><span class="cmp__dash" aria-hidden="true"></span></td>
              <td class="cmp__cell" data-col="3" aria-label="Not included"><span class="cmp__dash" aria-hidden="true"></span></td>
            </tr>
            <tr>
              <td class="cmp__feat">A repetitive manual workflow automated with human oversight</td>
              <td class="cmp__cell" data-col="1" aria-label="Not included"><span class="cmp__dash" aria-hidden="true"></span></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Not included"><span class="cmp__dash" aria-hidden="true"></span></td>
              <td class="cmp__cell" data-col="3" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
            </tr>
            <tr>
              <td class="cmp__feat">Governance layer: human-in-the-loop, audit trail, rollback</td>
              <td class="cmp__cell" data-col="1" aria-label="Not included"><span class="cmp__dash" aria-hidden="true"></span></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Not included"><span class="cmp__dash" aria-hidden="true"></span></td>
              <td class="cmp__cell" data-col="3" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
            </tr>
            <tr>
              <td class="cmp__feat">Built and validated on your live data</td>
              <td class="cmp__cell" data-col="1" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell" data-col="3" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
            </tr>
            <tr>
              <td class="cmp__feat">Scoped from a paid diagnostic, with written acceptance criteria</td>
              <td class="cmp__cell" data-col="1" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell" data-col="3" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
            </tr>
            <tr>
              <td class="cmp__feat">A UAT-and-hardening phase before handover</td>
              <td class="cmp__cell" data-col="1" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell" data-col="3" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
            </tr>
            <tr>
              <td class="cmp__feat">Runbooks, monitoring and alerting</td>
              <td class="cmp__cell" data-col="1" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell" data-col="3" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
            </tr>
            <tr>
              <td class="cmp__feat">Source in your own repository, no lock-in</td>
              <td class="cmp__cell" data-col="1" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell" data-col="3" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
            </tr>
            <tr>
              <td class="cmp__feat">A defined post-handover support window</td>
              <td class="cmp__cell" data-col="1" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell cmp__col-sel" data-col="2" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
              <td class="cmp__cell" data-col="3" aria-label="Included"><svg class="cmp__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12" /></svg></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="tile tile--dark" id="services-how">
    <div class="inner center sreveal">
      <div class="eyebrow eyebrow--dark">How it works</div>
      <h2 class="metrics__h2" style="color:#fff" data-reveal-words>From manual and fragile to reliable, in three phases.</h2>
      <p class="hero__sub" style="color:#9ca3af;max-width:600px;margin-left:auto;margin-right:auto">Modular by design. Start with whichever phase fits, there’s no obligation to take all three.</p>
      <div class="flow__more sreveal">
        <a href="#">See the full step-by-step <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="phases" data-stagger>

      <article class="phase sreveal" data-tilt data-tilt-max="3">
        <span class="phase__tag">Start here</span>
        <div class="phase__arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h14" /><path d="M13 6l6 6-6 6" /></svg></div>
        <header class="phase__head">
          <span class="phase__num" aria-hidden="true">1</span>
          <span class="phase__eyebrow">Diagnostic</span>
          <h3 class="phase__title">Phase 1</h3>
          <p class="phase__sub">Find the real problems.</p>
        </header>
        <div class="phase__chips">
          <span class="phase__chip">Discovery call</span>
          <span class="phase__chip">Data audit</span>
          <span class="phase__chip">Live sample dashboard</span>
          <span class="phase__chip">Fixed-price roadmap</span>
        </div>
        <ul class="phase__list">
          <li><span class="phase__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg></span>Blind spots found</li>
          <li><span class="phase__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg></span>Cost of inaction quantified</li>
          <li><span class="phase__ic" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg></span>A working sample built</li>
